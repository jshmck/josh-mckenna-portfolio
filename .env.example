# Resend API key, used by app/api/contact/route.ts and
# app/api/waitlist/route.ts to send/store data server-side. Get one at
# https://resend.com/api-keys.
RESEND_API_KEY=

# Resend Audience that shop waitlist signups get added to as contacts.
# Find the id in the audience's URL (resend.com/audiences/<id>/contacts) or
# the "</>" code snippet next to "+ Add contacts". Used by
# app/api/waitlist/route.ts.
RESEND_AUDIENCE_ID=
