# Resend API key, used by app/api/contact/route.ts and
# app/api/waitlist/route.ts to send/store data server-side. Get one at
# https://resend.com/api-keys.
RESEND_API_KEY=

# Resend segment (dashboard still labels this "Audience" in places) that
# shop waitlist signups get added to as contacts. Create one in the Resend
# dashboard under Audiences/Segments and paste its id here. Used by
# app/api/waitlist/route.ts.
RESEND_SEGMENT_ID=
